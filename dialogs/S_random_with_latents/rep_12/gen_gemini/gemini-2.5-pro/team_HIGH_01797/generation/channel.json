            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M15",
            "speaker_id": 10272,
            "reply_to": "M14",
            "text": "Great. So we're agreed on the level of detail for the mapping. I'll summarize.",
            "mentions": [],
