            "speaker_id": 177366,
            "reply_to": "M30",
            "text": "Okay, that makes sense. I'm happy with them then. Thanks for clarifying!",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M32",
            "speaker_id": 246501,
            "reply_to": "M30",
