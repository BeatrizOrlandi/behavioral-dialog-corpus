            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M51",
            "speaker_id": 89373,
            "reply_to": "M43",
            "text": "For the pilot (T9), are we offering all three tiers? Or should we start with just one or two to simplify feedback collection?",
