        "thread_id": "TH1",
        "thread_goal": "Align on scope and pick which vehicles join the initial pilot",
        "messages": [
          {
            "msg_id": "M1",
            "speaker_id": 203126,
            "reply_to": null,
            "text": "Team, let's kick off the Fleet Maintenance and Workshop Safety Standardization project. First step is planning the pilot for the new routines as per T10. We need to select a few vehicles to test the new checklists and procedures without disrupting the whole fleet. Any thoughts on which ones would be best?",
            "mentions": [],
            "artifact_refs": [
              "T10"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M2",
            "speaker_id": 109283,
            "reply_to": "M1",
            "text": "Good idea. Let's just grab the first 5 trucks that come in for servicing next week. Easy to manage.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M3",
            "speaker_id": 108987,
            "reply_to": "M1",
            "text": "What's a pilot?",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M4",
            "speaker_id": 203126,
            "reply_to": "M2",
            "text": "That's one way, but we might get a skewed result. To really test the new process, we should probably focus on the high-usage vehicles mentioned in T2. They're the ones that break down most often. We can check the schedule board A3 to identify the top 5 workhorses.",
            "mentions": [
              109283
            ],
            "artifact_refs": [
              "T2",
              "A3"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "bulb",
                "count": 1
              }
            ]
          },
          {
            "msg_id": "M5",
            "speaker_id": 203126,
            "reply_to": "M3",
            "text": "It's a small-scale test before we roll out the changes to everyone. Helps us find problems early.",
            "mentions": [
              108987
            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M6",
