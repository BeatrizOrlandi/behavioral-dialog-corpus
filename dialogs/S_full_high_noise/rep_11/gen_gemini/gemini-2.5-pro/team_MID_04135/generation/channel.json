            ],
            "artifact_refs": [],
            "decision_refs": [
              "D6"
            ],
            "reactions": [
              {
                "emoji": "+1",
                "count": 2
              }
            ]
          },
          {
            "msg_id": "M49",
            "speaker_id": 76651,
            "reply_to": "M48",
            "text": "Excellent. I'll now finalize all the details in A7 and book the venue. T9 is well underway.",
            "mentions": [],
