            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M70",
            "speaker_id": 76106,
            "reply_to": "M69",
            "text": "So, I propose we track three main things for the pilot: 1) Workshop attendance, 2) Achievement of client's primary employment goal (e.g., placement secured), and 3) Sustained employment at the 1-month mark. Are we happy with these as our key indicators?",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [
              "D9"
            ],
            "reactions": []
          },
