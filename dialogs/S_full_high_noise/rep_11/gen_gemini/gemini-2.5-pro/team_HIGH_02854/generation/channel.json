            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M5",
            "speaker_id": 320085,
            "reply_to": "M4",
            "text": "Hi @59927, the details are in the first section of the doc A1 linked above. This is a new segmentation specific to this subscription product.",
            "mentions": [
              59927
