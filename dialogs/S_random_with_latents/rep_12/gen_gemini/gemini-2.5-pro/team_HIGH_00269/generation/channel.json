            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M30",
            "speaker_id": 237414,
            "reply_to": "M28",
            "text": "Excellent, critical additions @21079. That's exactly what we need for T7. I'll merge these rules directly into A3 to keep it all in one place. So, to confirm: max stack height 1.5m in corridors, heavy materials on bottom shelves only, and zero stacking in marked access paths.",
            "mentions": [
              21079
            ],
            "artifact_refs": [
              "A3",
              "T7"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M31",
            "speaker_id": 21079,
            "reply_to": "M30",
            "text": "Correct. Those rules are non-negotiable for safety.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": [
              {
