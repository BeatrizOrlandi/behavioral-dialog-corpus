          {
            "msg_id": "M14",
            "speaker_id": 87939,
            "reply_to": "M10",
            "text": "Great, let's proceed with that group. I'm making the decision official. And we'll aim for the 4-6pm slot on weekdays for activities.",
            "mentions": [],
