            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M13",
            "speaker_id": 157604,
            "reply_to": "M11",
            "text": "Yes, A8 is a daily log. It will be on a clipboard next to the main fridge in the kitchen.",
            "mentions": [
              92532
            ],
            "artifact_refs": [
              "A8"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M14",
            "speaker_id": 95695,
            "reply_to": "M9",
            "text": "The procedure in A4 seems robust. The pre-departure checklist is key. It prevents an aide from leaving with a container that wasn't properly chilled or sealed. This mitigates a major risk.",
            "mentions": [],
