            "msg_id": "M71",
            "speaker_id": 11000,
            "reply_to": "M69",
            "text": "I'll be on shift next week, I can help with the pilot run.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
