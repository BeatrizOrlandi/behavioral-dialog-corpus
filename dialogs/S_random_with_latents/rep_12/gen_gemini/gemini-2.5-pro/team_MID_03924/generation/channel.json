              59192
            ],
            "artifact_refs": [
              "A2"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "+1",
                "count": 2
              }
            ]
          },
          {
            "msg_id": "M29",
            "speaker_id": 8267,
            "reply_to": "M27",
            "text": "It's the risk of having too much revenue coming from a small number of clients. For example, if one client represents 50% of revenue. It's a key risk indicator for many SMEs. I'll add a definition in A2.",
            "mentions": [
              59192
            ],
            "artifact_refs": [
              "A2"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M30",
            "speaker_id": 59192,
            "reply_to": "M29",
            "text": "Thank you, that makes sense now. I will wait for your and @89373's comments in A2 and then I will make a new version.",
