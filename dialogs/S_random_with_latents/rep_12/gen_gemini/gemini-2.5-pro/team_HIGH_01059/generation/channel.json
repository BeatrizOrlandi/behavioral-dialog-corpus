        "thread_id": "TH4",
        "thread_goal": "Plan and monitor the pilot rollout, including escalation paths and dashboards.",
        "messages": [
          {
            "msg_id": "M58",
            "speaker_id": 379361,
            "reply_to": null,
            "text": "Alright team, we're ready to kick off the pilot for T8. I've confirmed the participants: Sales Pod B and Contact Centre Team 3. We'll run it for two weeks starting next Monday. Let's use this thread to finalize the remaining details.",
            "mentions": [
              8337,
