          {
            "msg_id": "M27",
            "speaker_id": 177366,
            "reply_to": "M26",
            "text": "Looks good. Just one question, do we have to say these exact words? Sometimes it feels more natural to say it a bit differently depending on the customer.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M28",
            "speaker_id": 427273,
            "reply_to": "M26",
            "text": "I've reviewed A2, it's solid. I approve.",
            "mentions": [],
            "artifact_refs": [
              "A2"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "+1",
                "count": 1
              }
            ]
          },
          {
            "msg_id": "M29",
            "speaker_id": 244639,
            "reply_to": "M26",
            "text": "looks ok.",
            "mentions": [],
