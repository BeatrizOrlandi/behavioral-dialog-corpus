        "messages": [
          {
            "msg_id": "M46",
            "speaker_id": 20729,
            "reply_to": null,
            "text": "Hi all, let's talk about rollout. I've drafted a training checklist (A4) to cover the new processes from T5. I've also put together a proposed implementation schedule (A8) for T10, aiming for our quietest periods. Please review.",
            "mentions": [],
            "artifact_refs": [
