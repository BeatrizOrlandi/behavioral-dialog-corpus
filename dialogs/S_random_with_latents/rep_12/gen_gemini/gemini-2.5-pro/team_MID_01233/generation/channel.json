            "speaker_id": 237177,
            "reply_to": "M46",
            "text": "Ok, I will wait for the final specs then.",
            "mentions": [
              36422
            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M48",
            "speaker_id": 18383,
            "reply_to": "M43",
            "text": "I have updated A4 with the new frequency. The cost increase is minimal. I also added some notes for the wiring as part of T11 to check compatibility with the existing control panels.",
            "mentions": [
              560411
            ],
            "artifact_refs": [
              "A4",
              "T11"
            ],
            "decision_refs": [],
            "reactions": []
