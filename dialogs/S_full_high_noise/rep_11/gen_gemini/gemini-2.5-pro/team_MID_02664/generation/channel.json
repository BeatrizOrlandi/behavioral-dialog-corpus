            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M8",
            "speaker_id": 65624,
            "reply_to": "M7",
            "text": "Those three metrics are perfect. Capturing 'number of new leads' is key, as many people might not invest on their first visit. This will help us measure engagement beyond just the initial sales.",
