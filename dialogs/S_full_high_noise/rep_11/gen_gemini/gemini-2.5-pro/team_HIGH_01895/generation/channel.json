      {
        "thread_id": "TH5",
        "thread_goal": "Plan training, shift handovers and weekly review cadence",
        "messages": [
          {
            "msg_id": "M53",
            "speaker_id": 203126,
            "reply_to": null,
            "text": "As we finalize these new procedures, we need to plan how to communicate them. This covers T6 (handovers), T8 (training), and T12 (reviews). For handovers, I've drafted a simple 'Shift Handover Notes Template' (A5). The idea is the outgoing shift fills it out 15 mins before clocking off, noting any open issues or priorities.",
            "mentions": [],
            "artifact_refs": [
              "T6",
              "T8",
              "T12",
              "A5"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M54",
            "speaker_id": 109283,
            "reply_to": "M53",
            "text": "Just looked at A5. It's simple and clear. I can start using it tonight to test it out.",
            "mentions": [],
            "artifact_refs": [
              "A5"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "+1",
                "count": 1
              }
            ]
          },
          {
            "msg_id": "M55",
            "speaker_id": 156061,
            "reply_to": "M53",
            "text": "Do we have to fill it out even if there's nothing to report?",
