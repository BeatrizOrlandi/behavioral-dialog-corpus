            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M37",
            "speaker_id": 19278,
            "reply_to": "M36",
            "text": "Good call. I'll add a 'Direct Supervisor' column. That makes it crystal clear for the hotel staff. Done.",
