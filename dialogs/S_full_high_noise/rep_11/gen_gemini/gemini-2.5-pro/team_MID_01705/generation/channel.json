            "text": "Looks good to me.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M46",
            "speaker_id": 323962,
            "reply_to": "M43",
            "text": "I approve.",
            "mentions": [],
            "artifact_refs": [],
