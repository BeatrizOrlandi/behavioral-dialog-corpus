            "reply_to": "M11",
            "text": "ok",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M15",
            "speaker_id": 394531,
            "reply_to": "M12",
            "text": "Perfect. Decision D1 is locked. And can we also confirm the high-level journey map I described earlier as our baseline for the project? (Awareness -> Inquiry -> Visit -> Purchase -> Support).",
            "mentions": [],
            "artifact_refs": [],
