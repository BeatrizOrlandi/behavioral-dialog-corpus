          {
            "msg_id": "M15",
            "speaker_id": 366315,
            "reply_to": "M14",
            "text": "While we're observing the process, should we start logging issues? We could use a simple version of the feedback log A5.",
            "mentions": [],
            "artifact_refs": [
              "A5"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M16",
            "speaker_id": 18289,
            "reply_to": "M15",
            "text": "Excellent idea. It's never too early to start collecting data. I'll set up a sheet for us to use.",
            "mentions": [],
