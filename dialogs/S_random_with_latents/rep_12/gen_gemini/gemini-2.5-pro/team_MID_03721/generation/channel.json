              6370,
              75507,
              448709,
              472507,
              561463
            ],
            "artifact_refs": [
              "A1",
              "T1"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M2",
            "speaker_id": 6370,
            "reply_to": "M1",
            "text": "Thanks for starting this. The draft in A1 looks solid. From the front lines, the most critical feature is a powerful, easy-to-use search for the knowledge base. If customers can't find what they need in seconds, they'll just call us. I've already started pulling data for T2, and search is key.",
            "mentions": [
              59590
