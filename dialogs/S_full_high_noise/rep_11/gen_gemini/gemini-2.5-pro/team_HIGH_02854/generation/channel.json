            "artifact_refs": [
              "A1"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M4",
            "speaker_id": 59927,
            "reply_to": "M1",
            "text": "Hi, where can I find the info on the target segments? Is it the same as the one from the Q3 campaign?",
