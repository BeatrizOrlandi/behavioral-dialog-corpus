        "thread_id": "TH2",
        "thread_goal": "Define the move schedule and resource plan across shifts.",
        "messages": [
          {
            "msg_id": "M14",
            "speaker_id": 136230,
            "reply_to": null,
            "text": "Okay team, now that we have the scope, we need to build the schedule. I've started the Move Schedule A5. Please add your input on the best time windows for the moves, keeping peak operational hours in mind. This is for task T5.",
            "mentions": [
              49303,
              53954,
              112406,
              153021,
              304178
            ],
            "artifact_refs": [
              "A5",
              "T5"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M15",
            "speaker_id": 49303,
            "reply_to": "M14",
            "text": "For the warehouse, we absolutely have to avoid 7-10 AM and 3-5 PM. Those are our busiest shipping and receiving times. Evenings after 7 PM or weekends would be best.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "+1",
                "count": 1
              }
            ]
          },
          {
            "msg_id": "M16",
            "speaker_id": 304178,
            "reply_to": "M15",
            "text": "We could do it super early, like starting at 4 AM! We can get a lot done before anyone is here.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M17",
            "speaker_id": 153021,
            "reply_to": "M16",
            "text": "4 AM might be tough for getting forklift access and supervisor sign-off. Evenings or a Saturday seem more realistic. We'll need to check with the warehouse supervisor.",
