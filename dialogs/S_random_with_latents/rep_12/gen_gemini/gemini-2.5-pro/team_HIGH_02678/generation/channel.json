            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M21",
            "speaker_id": 6784,
            "reply_to": "M20",
            "text": "We ran a market benchmark last month, and this price positions us as a premium service, which aligns with our brand strategy. The value is in the integrated SLA and single point of contact, which competitors don't offer in the same way. We can monitor this with the post-launch KPIs (T10).",
            "mentions": [
              90589
            ],
            "artifact_refs": [
              "T10"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M22",
            "speaker_id": 83919,
            "reply_to": "M15",
            "text": "The discount rules are clear. So sales can't go above the max discount without approval?",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M23",
            "speaker_id": 6784,
            "reply_to": "M22",
