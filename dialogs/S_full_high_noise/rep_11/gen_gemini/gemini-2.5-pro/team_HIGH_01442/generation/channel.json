            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M12",
            "speaker_id": 36599,
            "reply_to": "M10",
            "text": "That list makes sense. Sam can be a bit shy in groups but he might open up. Maria has been asking for more things to do.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
