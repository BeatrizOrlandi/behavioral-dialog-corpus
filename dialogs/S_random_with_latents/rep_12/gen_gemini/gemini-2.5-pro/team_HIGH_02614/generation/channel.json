            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M12",
            "speaker_id": 157604,
            "reply_to": "M10",
            "text": "It's a central check. The checklist in A4 has a sign-off for the cook on duty before the meals go out. We only have one calibrated food thermometer for now.",
            "mentions": [
              520047
