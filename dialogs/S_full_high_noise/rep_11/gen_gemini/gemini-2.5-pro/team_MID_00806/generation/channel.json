              "A1",
              "T8"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "memo",
                "count": 2
              }
            ]
          },
          {
            "msg_id": "M7",
            "speaker_id": 427273,
            "reply_to": "M6",
            "text": "Done. I've added a few more to A1 based on my shift yesterday. I've also started grouping them like in T1.",
            "mentions": [],
            "artifact_refs": [
              "A1",
              "T1"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "rocket",
