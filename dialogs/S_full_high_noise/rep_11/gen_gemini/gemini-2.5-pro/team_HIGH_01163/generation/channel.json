            "msg_id": "M82",
            "speaker_id": 427511,
            "reply_to": "M74",
            "text": "looks ok",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M83",
            "speaker_id": 361403,
            "reply_to": "M75",
            "text": "Thanks for clarifying @499701. And thank you for offering to draft the rubric, that would be a great help. I'll add it to the A6 template once it's ready.",
