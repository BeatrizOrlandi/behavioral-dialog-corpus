            "speaker_id": 334628,
            "reply_to": "M44",
            "text": "The daily progress log T11 was very useful. It was easy to see what was happening. The storage plan also worked well.",
            "mentions": [],
            "artifact_refs": [
              "T11"
            ],
            "decision_refs": [],
            "reactions": []
          },
