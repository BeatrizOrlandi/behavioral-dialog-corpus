            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M74",
            "speaker_id": 242297,
            "reply_to": "M72",
            "text": "I agree with iterating. The pilot customers are good candidates to become our first paying customers if we deliver on these improvements.",
            "mentions": [
              94563
            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M75",
            "speaker_id": 22473,
            "reply_to": "M72",
            "text": "Oh, I see. So we keep going but just add those things. Ok.",
