          {
            "msg_id": "M20",
            "speaker_id": 87779,
            "reply_to": "M19",
            "text": "Thanks for putting this together so fast. I'm looking at A3, and I see the salmon portion is set to 180g. Is that right for a lunch dish? It's driving the cost up significantly.",
            "mentions": [],
            "artifact_refs": [
              "A3"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M21",
            "speaker_id": 9052,
            "reply_to": "M20",
            "text": "Oh, yeah I just used our standard dinner portion size. We can definitely reduce it for lunch. What do you think, 150g?",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M22",
            "speaker_id": 150886,
            "reply_to": "M21",
            "text": "Good catch, 87779. For a lunch menu, 140g is a more standard portion and it will definitely help us hit our target food cost. Let's set it at 140g.",
            "mentions": [
              87779
            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "heavy_plus_sign",
                "count": 1
              }
            ]
          },
