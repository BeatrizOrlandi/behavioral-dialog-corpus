            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M20",
            "speaker_id": 285875,
            "reply_to": "M19",
            "text": "Thanks, this looks great. The structure in A2 is very clear. The 'What's in it for me?' angle for each tier is strong.",
