        "thread_id": "TH1",
        "thread_goal": "Align on current issues and approve target workshop zoning concept.",
        "messages": [
          {
            "msg_id": "M1",
            "speaker_id": 237414,
            "reply_to": null,
            "text": "Team, let's kick off the workshop layout redesign. I've started a draft plan in A1. Before we go further, could everyone please list their top 1-2 pain points with the current setup? @11765 @21079 @54659 @149461",
            "mentions": [
