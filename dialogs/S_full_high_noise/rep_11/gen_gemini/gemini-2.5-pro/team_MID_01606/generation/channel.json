                "count": 3
              }
            ]
          },
          {
            "msg_id": "M16",
            "speaker_id": 22473,
            "reply_to": "M15",
            "text": "Thanks for summarizing.",
            "mentions": [
              94563
            ],
            "artifact_refs": [],
