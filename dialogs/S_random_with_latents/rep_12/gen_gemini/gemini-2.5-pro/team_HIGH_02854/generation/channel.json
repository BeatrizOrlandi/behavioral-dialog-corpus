          },
          {
            "msg_id": "M29",
            "speaker_id": 270220,
            "reply_to": "M28",
            "text": "Great, I'll get started on the creative brief for T5 then.",
            "mentions": [],
            "artifact_refs": [
              "T5"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M30",
            "speaker_id": 242297,
            "reply_to": "M28",
            "text": "I've updated A2 with the new allocation. The budget allocation per channel is now confirmed. Let's move forward.",
            "mentions": [],
