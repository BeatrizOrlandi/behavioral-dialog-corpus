            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M33",
            "speaker_id": 10272,
            "reply_to": "M32",
            "text": "That's a good point. I assumed it would just be part of our regular clocked-in time.",
            "mentions": [],
