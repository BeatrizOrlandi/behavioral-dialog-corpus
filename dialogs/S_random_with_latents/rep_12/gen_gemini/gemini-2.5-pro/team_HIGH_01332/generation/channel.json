              375245
            ],
            "artifact_refs": [
              "T12",
              "A8",
              "A1"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "thinking_face",
                "count": 1
              }
            ]
          },
          {
            "msg_id": "M44",
            "speaker_id": 81248,
            "reply_to": "M43",
            "text": "Another great suggestion. A self-check step is a perfect way to improve quality without adding much time. So, two adjustments for A1: move up the reminder and add a pre-review attachment check. Are we all in agreement on these changes?",
            "mentions": [
              16157,
              375245,
              457591,
              523876
