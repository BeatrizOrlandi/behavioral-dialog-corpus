            "speaker_id": 221215,
            "reply_to": "M5",
            "text": "Works for me.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M8",
            "speaker_id": 62106,
            "reply_to": "M5",
            "text": "ok with me too",
            "mentions": [],
