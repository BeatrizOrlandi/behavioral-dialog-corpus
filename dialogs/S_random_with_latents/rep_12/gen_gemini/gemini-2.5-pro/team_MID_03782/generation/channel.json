          },
          {
            "msg_id": "M57",
            "speaker_id": 56723,
            "reply_to": "M56",
            "text": "Oh, that's a very good point. I missed that. Thank you, @89425. I'll add that to the checklist and make sure @605 includes it in the final comms.",
            "mentions": [
