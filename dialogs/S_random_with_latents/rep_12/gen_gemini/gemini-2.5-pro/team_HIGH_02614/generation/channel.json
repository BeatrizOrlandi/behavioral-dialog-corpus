            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M21",
            "speaker_id": 518039,
            "reply_to": "M20",
            "text": "No, it's mostly check-boxes. You'd only write a note if something is wrong. We can time it in the dry run to be sure.",
