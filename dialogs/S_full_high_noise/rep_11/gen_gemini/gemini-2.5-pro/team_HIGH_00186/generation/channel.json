            "reply_to": "M1",
            "text": "Sorry, where can I find the document?",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M8",
            "speaker_id": 488135,
            "reply_to": "M7",
            "text": "@31942 It's linked in the first message: A1.",
            "mentions": [
              31942
            ],
