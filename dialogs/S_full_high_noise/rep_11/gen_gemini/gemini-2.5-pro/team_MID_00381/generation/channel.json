          {
            "msg_id": "M48",
            "speaker_id": 48703,
            "reply_to": null,
            "text": "Alright team, it's time to plan the pilot for T10. Based on our earlier decision and the data in A4, I've confirmed that 'City Center' and 'South Heights' are ready. I propose we start the pilot on the 1st of next month. I've also drafted the owner and tenant communication pack in A7.",
            "mentions": [
              54175,
              128593,
              167424,
              52814
            ],
            "artifact_refs": [
              "T10",
              "A4",
              "A7"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M49",
            "speaker_id": 167424,
