        "messages": [
          {
            "msg_id": "M42",
            "speaker_id": 87779,
            "reply_to": null,
            "text": "Hi team, the internal tasting session for T7 is complete. I've logged all the feedback in A7 Tasting Session Notes and Adjustments Log. Based on what we plated, I've also created a first draft of the A5 Plating and Service Guide. Take a look.",
            "mentions": [
