              "T1",
              "A1"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M2",
            "speaker_id": 221215,
            "reply_to": "M1",
            "text": "Got it. Looking at the map, Zones B and C seem like a good place to start. They look pretty straightforward.",
