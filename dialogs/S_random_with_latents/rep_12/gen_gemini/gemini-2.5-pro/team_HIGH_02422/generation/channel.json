        "messages": [
          {
            "msg_id": "M19",
            "speaker_id": 9052,
            "reply_to": null,
            "text": "Team, I've put together the first drafts for the A2 Standard Recipe Cards Pack and the A3 Dish Costing and Food Cost Tracker. Have a look when you can. Some of the costs are coming in a bit high, especially the salmon.",
            "mentions": [
