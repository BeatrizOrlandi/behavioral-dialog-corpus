        "messages": [
          {
            "msg_id": "M68",
            "speaker_id": 200052,
            "reply_to": null,
            "text": "Hello, the 30-day pilot is now complete. I have started T12. We had a good number of farmers visit and the feedback seems positive. I think we should continue with the project.",
            "mentions": [
              88246,
              83675,
              59001,
              359687
            ],
            "artifact_refs": [
              "T12"
            ],
            "decision_refs": [],
