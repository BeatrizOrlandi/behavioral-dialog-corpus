            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M22",
            "speaker_id": 109659,
            "reply_to": "M20",
            "text": "I agree with @60334 on the 'Status' column for A2. We should also add a 'Document Link' column so people can link directly to the evidence file. And an 'Owner' column is critical to assign responsibility for each line item.",
            "mentions": [
