        "messages": [
          {
            "msg_id": "M33",
            "speaker_id": 125309,
            "reply_to": null,
            "text": "Hi all, I've drafted the standard procedure for telecom and electronics visits as A4, which should complete T4. It includes the pre-visit checks we discussed, steps for signal testing, and logging requirements. Feedback is welcome.",
            "mentions": [
