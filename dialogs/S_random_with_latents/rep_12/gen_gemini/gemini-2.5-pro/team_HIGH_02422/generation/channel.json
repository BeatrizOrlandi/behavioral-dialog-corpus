          {
            "msg_id": "M55",
            "speaker_id": 84871,
            "reply_to": "M54",
            "text": "I love that idea. It's much safer and sets us up for success. Let's confirm that plan. Launch is next Monday with a reduced menu, and the full menu will be live on Wednesday.",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [
