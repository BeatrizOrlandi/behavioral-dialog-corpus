          {
            "msg_id": "M19",
            "speaker_id": 518039,
            "reply_to": null,
            "text": "Hi all, here is the first draft of the Home Visit Checklist (A2) for T3. The goal is to cover all key points in under 5 minutes. Feedback is welcome.",
