        "thread_goal": "Agree on monitoring, evaluation, and data collection processes.",
        "messages": [
          {
            "msg_id": "M57",
            "speaker_id": 393987,
            "reply_to": null,
            "text": "Hello, here is the first draft of the Monitoring and Evaluation Framework, A4. It includes the three metrics we decided on in D2.",
            "mentions": [],
            "artifact_refs": [
              "A4"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
