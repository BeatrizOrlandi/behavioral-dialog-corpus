              }
            ]
          },
          {
            "msg_id": "M17",
            "speaker_id": 462838,
            "reply_to": "M16",
            "text": "ok got it",
            "mentions": [],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M18",
            "speaker_id": 558848,
            "reply_to": "M16",
            "text": "Great. Next steps: @433963 can you start drafting the standard food line checklist based on this discussion (part of T3)? @310108 can you do the same for the metal saw area (related to T6)? Let's aim for first drafts by tomorrow EOD.",
            "mentions": [
