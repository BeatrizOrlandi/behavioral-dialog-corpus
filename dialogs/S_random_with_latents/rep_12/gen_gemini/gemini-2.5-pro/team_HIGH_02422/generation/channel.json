            "speaker_id": 150886,
            "reply_to": "M19",
            "text": "Also, looking at the quinoa bowl recipe in A2, it specifies red quinoa. Our supplier charges more for that. White quinoa is cheaper and the texture difference in that particular dish is negligible. We could make a substitution there to save on cost.",
            "mentions": [],
            "artifact_refs": [
              "A2"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "bulb",
                "count": 1
              }
            ]
          },
