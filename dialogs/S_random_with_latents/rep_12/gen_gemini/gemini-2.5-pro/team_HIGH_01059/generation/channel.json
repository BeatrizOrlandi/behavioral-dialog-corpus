            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M70",
            "speaker_id": 379361,
            "reply_to": "M69",
            "text": "I'll be responsible for T6. I'll set up a dashboard view in the CRM using the fields we agreed on and will post a daily summary of the KPIs from A4 in this channel so we can all monitor progress.",
            "mentions": [],
            "artifact_refs": [
              "T6",
