            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M23",
            "speaker_id": 30302,
            "reply_to": "M22",
            "text": "Oh, I see. Ok, that makes sense. We should make that very clear in the training.",
