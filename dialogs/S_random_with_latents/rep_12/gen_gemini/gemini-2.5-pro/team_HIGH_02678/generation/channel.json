            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M16",
            "speaker_id": 82217,
            "reply_to": "M15",
            "text": "Got it. What's the timeline for getting finance to approve the margin analysis?",
            "mentions": [
              6784
