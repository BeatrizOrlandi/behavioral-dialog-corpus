            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M27",
            "speaker_id": 59192,
            "reply_to": "M25",
            "text": "Ok, I will add the consent check. What is customer concentration?",
            "mentions": [
              8267
            ],
            "artifact_refs": [],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M28",
            "speaker_id": 89373,
            "reply_to": "M26",
            "text": "Let's not remove them yet. Let's categorize them into 'Primary' and 'Secondary' indicators. The dashboard will focus on the Primary ones. I'll add suggestions directly in the A2 doc.",
