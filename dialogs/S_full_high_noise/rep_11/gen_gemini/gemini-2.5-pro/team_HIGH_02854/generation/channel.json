          {
            "msg_id": "M58",
            "speaker_id": 242297,
            "reply_to": "M57",
            "text": "Thanks for putting this together. The list of KPIs (Sign-ups, Churn, ARPU, CAC) looks right. In A6, can you clarify how Customer Acquisition Cost (CAC) will be calculated? I want to make sure it aligns with the spend we're tracking in A2 and that we're consistent with how Finance reports it.",
            "mentions": [],
            "artifact_refs": [
              "A6",
              "A2"
