            "artifact_refs": [
              "A3",
              "A5"
            ],
            "decision_refs": [],
            "reactions": []
          },
          {
            "msg_id": "M49",
            "speaker_id": 65624,
            "reply_to": "M46",
            "text": "I love the idea of a qualitative feedback section in A8. We can note common customer questions or objections there. For the daily tracker A3, can we make sure it's a simple format? The store staff will be filling it out, so it needs to be quick and easy.",
            "mentions": [],
            "artifact_refs": [
              "A8",
              "A3"
            ],
            "decision_refs": [],
            "reactions": [
              {
                "emoji": "+1",
