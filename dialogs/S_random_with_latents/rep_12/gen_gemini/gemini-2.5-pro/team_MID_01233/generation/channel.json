      {
        "thread_id": "TH4",
        "thread_goal": "Coordinate pilot go-live, training, and daily status updates.",
        "messages": [
          {
            "msg_id": "M56",
            "speaker_id": 36422,
            "reply_to": null,
            "text": "Team, we are one week away from the pilot go-live. This thread is for coordinating all activities for T9. The maintenance windows are confirmed as per T5. Let's use this space for daily updates once installation begins.",
            "mentions": [
